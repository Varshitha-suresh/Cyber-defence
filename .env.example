# Cyber Defence System Environment Configuration

# Database Configuration (PostgreSQL default, SQLite fallback supported for standalone testing)
DATABASE_URL=sqlite:///./cyber_defence.db
POSTGRES_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyber_defence

# Authentication Security
JWT_SECRET=super-secret-cyber-defence-jwt-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Threat & Breach Intelligence API (Demo fallback is available when key is blank)
BREACH_API_URL=https://haveibeenpwned.com/api/v3
BREACH_API_KEY=

# Application Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
PORT=8000
HOST=0.0.0.0
